# WhatsApp API configuration
WHATSAPP_HOST=""
WHATSAPP_AUTH=""
# Must equal the gateway's --webhook-secret (go-whatsapp-web-multidevice signs webhooks with it).
# The webhook refuses every request while this is empty.
WHATSAPP_WEBHOOK_SECRET=""
# Comma-separated numbers allowed to publish devotionals, e.g. "6281234567890,6289876543210".
# Empty = nobody can publish through the bot.
WHATSAPP_ADMIN_PHONES=""

# Google Generative AI API configuration
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""