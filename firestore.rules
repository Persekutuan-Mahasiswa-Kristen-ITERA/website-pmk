rules_version = '2';

// Public site content is readable by everyone. All writes go through the Next.js
// server (/api/admin/*, Firebase Admin SDK), which bypasses these rules, so no
// browser may write directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read: if collection in ['articles', 'devotionals', 'events', 'documentations'];
      allow write: if false;
    }
  }
}
